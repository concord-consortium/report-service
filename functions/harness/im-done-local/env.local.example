# Copy these into functions/.env.local before starting the emulator for the
# local "I'm Done" harness. .env.local is gitignored and loaded by the Firebase
# functions emulator for every project.
#
#   - TRUSTED_PORTAL_HOSTS lets validatePortalHost accept the loopback stub
#     (localhost) as well as the staging portal.
#   - PORTAL_OIDC_TOKEN is required by portalOidcFetch's emulator path; the stub
#     portal ignores its value, so any non-empty string works here.

TRUSTED_PORTAL_HOSTS=learn.portal.staging.concord.org,localhost,127.0.0.1
PORTAL_OIDC_TOKEN=stub-oidc-token
